---
/**
 * WordMap: plots words on a 2D graph using two scores between 0 and 1.
 *
 * Without JavaScript it's a static SVG picture. Hovering, tapping or
 * tabbing to a word shows its numbers.
 *
 * With `editable`, readers can also drag words around (or use the arrow
 * keys), add their own words with two sliders, see which word is closest (in the caption),
 * and reset everything.
 *
 * With `shuffle`, every word gets two random numbers instead, and a
 * "Shuffle" button scatters them again.
 *
 * Usage in MDX:
 *   import WordMap from '../../components/WordMap.astro';
 *   <WordMap />
 *   <WordMap editable words={[...]} />
 */

type Placement = 'right' | 'left' | 'above' | 'below' | 'below-right';

interface Word {
  word: string;
  x: number; // first number (horizontal axis), 0 to 1
  y: number; // second number (vertical axis), 0 to 1
  group?: 'a' | 'b' | 'n'; // finance, animals, neutral
  label?: Placement;
}

interface Props {
  words?: Word[];
  xLabel?: string;
  yLabel?: string;
  caption?: string;
  editable?: boolean;
  shuffle?: boolean;
  placeholder?: string;
}

const {
  words: inputWords = [
    { word: 'money', x: 0.95, y: 0.05, group: 'a', label: 'right' },
    { word: 'cash', x: 0.9, y: 0.1, group: 'a', label: 'left' },
    { word: 'dog', x: 0.05, y: 0.95, group: 'b', label: 'right' },
    { word: 'hound', x: 0.1, y: 0.9, group: 'b', label: 'right' },
  ],
  xLabel = 'Finance',
  yLabel = 'Animals',
  editable = false,
  shuffle = false,
  placeholder = 'wallet',
  caption = shuffle
    ? 'Every word got two random numbers. Hit "Shuffle" to roll the dice again!'
    : editable
      ? 'Drag the words around, or add your own below.'
      : 'Hover over or tap a word to see its numbers.',
} = Astro.props;

// Plot geometry (SVG units). Passed to the script below via data-geom.
const SIZE = 300; // the plot area is a square
const LEFT = 64;
const TOP = 52;
const PAD = 0; // the graph starts at 0,0 (no word sits at exactly 0)
const W = LEFT + SIZE + 60;
const H = TOP + SIZE + 62;

const scale = (v: number) => ((v + PAD) / (1 + 2 * PAD)) * SIZE;
const px = (v: number) => LEFT + scale(v);
const py = (v: number) => TOP + SIZE - scale(v);
const AX = LEFT; // x position of the vertical axis
const AY = TOP + SIZE; // y position of the horizontal axis

// 0.9 -> "0.9", 0.0 -> "0.0", 0.95 -> "0.95"
const fmt = (n: number) => {
  const s = n.toFixed(2);
  return s.endsWith('0') ? n.toFixed(1) : s;
};

// Random scatter for `shuffle` maps. The same logic runs in the browser
// (see the script below), so keep the two in sync.
// Places each word at random, retrying until its dot and label don't overlap
// any other word's dot or label.
function scatter(list: Word[], rnd: () => number): Word[] {
  const boxes: number[][] = [];
  const hits = (b: number[]) => boxes.some((o) => b[0] < o[2] && b[2] > o[0] && b[1] < o[3] && b[3] > o[1]);
  return list.map((w) => {
    let best: Word = { ...w };
    for (let t = 0; t < 300; t++) {
      const x = Math.round((0.06 + rnd() * 0.88) * 100) / 100;
      const y = Math.round((0.06 + rnd() * 0.88) * 100) / 100;
      const label: Placement = x > 0.7 ? 'left' : 'right';
      const cx = px(x);
      const cy = py(y);
      const tw = w.word.length * 0.58 * 17 + 4;
      const dot = [cx - 10, cy - 10, cx + 10, cy + 10];
      const text = label === 'right' ? [cx + 10, cy - 9, cx + 14 + tw, cy + 10] : [cx - 14 - tw, cy - 9, cx - 10, cy + 10];
      best = { ...w, x, y, label };
      if (!hits(dot) && !hits(text)) {
        boxes.push(dot, text);
        return best;
      }
    }
    return best;
  });
}

// Small seeded random generator, so the static picture is always the same
function seeded(seed: number) {
  return () => {
    seed |= 0;
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
}

const words = shuffle ? scatter(inputWords, seeded(42)) : inputWords;

const OFFSETS: Record<Placement, { dx: number; dy: number; anchor: string }> = {
  right: { dx: 12, dy: 6, anchor: 'start' },
  left: { dx: -12, dy: 6, anchor: 'end' },
  above: { dx: 0, dy: -14, anchor: 'middle' },
  below: { dx: 0, dy: 24, anchor: 'middle' },
  'below-right': { dx: -4, dy: 24, anchor: 'start' },
};

// Tap/hover area around each dot: as big as possible without
// overlapping a neighbor's area (money and cash are very close).
const hitRadius = (w: Word) => {
  const others = words.filter((o) => o !== w);
  if (others.length === 0) return 16;
  const nearest = Math.min(
    ...others.map((o) => Math.hypot(px(o.x) - px(w.x), py(o.y) - py(w.y))),
  );
  return Math.max(6, Math.min(16, nearest / 2));
};

const ticks = [0, 0.25, 0.5, 0.75, 1];
const ariaSummary = words
  .map((w) => `${w.word}: ${xLabel.toLowerCase()} ${fmt(w.x)}, ${yLabel.toLowerCase()} ${fmt(w.y)}`)
  .join('; ');
const geom = JSON.stringify({ size: SIZE, left: LEFT, top: TOP, pad: PAD, offsets: OFFSETS });
---

<script is:inline>document.documentElement.classList.add('js');</script>
<figure
  class="wordmap"
  data-editable={editable ? '' : undefined}
  data-shuffle={shuffle ? '' : undefined}
  data-geom={geom}
>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    role="group"
    aria-label={`Graph with ${xLabel.toLowerCase()} scores on the horizontal axis and ${yLabel.toLowerCase()} scores on the vertical axis. ${ariaSummary}.`}
  >
    <!-- grid -->
    {ticks.map((t) => (
      <g class="wm-grid">
        <line x1={px(t)} y1={AY} x2={px(t)} y2={TOP} />
        <line x1={AX} y1={py(t)} x2={AX + SIZE} y2={py(t)} />
      </g>
    ))}

    <!-- axes -->
    <line class="wm-axis" x1={AX} y1={AY} x2={AX + SIZE + 12} y2={AY} />
    <line class="wm-axis" x1={AX} y1={AY} x2={AX} y2={TOP - 12} />
    <path class="wm-arrow" d={`M ${AX + SIZE + 12} ${AY} l -7 -4 v 8 z`} />
    <path class="wm-arrow" d={`M ${AX} ${TOP - 12} l -4 7 h 8 z`} />

    <!-- tick labels -->
    {[0, 0.5, 1].map((t) => (
      <>
        <text class="wm-tick" x={px(t)} y={AY + 22} text-anchor="middle">{fmt(t)}</text>
        <text class="wm-tick" x={AX - 10} y={py(t) + 5} text-anchor="end">{fmt(t)}</text>
      </>
    ))}

    <!-- axis labels -->
    <text class="wm-axis-label" x={AX + SIZE / 2} y={AY + 50} text-anchor="middle">{xLabel} →</text>
    <text
      class="wm-axis-label"
      x={18}
      y={TOP + SIZE / 2}
      text-anchor="middle"
      transform={`rotate(-90 18 ${TOP + SIZE / 2})`}
    >{yLabel} →</text>

    <!-- hint shown until a word is selected -->

    <!-- words -->
    <g class="wm-words">
      {words.map((w) => {
        const l = OFFSETS[w.label ?? 'right'];
        return (
          <g
            class={`wm-pt wm-pt-${w.group ?? 'a'}`}
            tabindex="0"
            role="img"
            aria-label={`${w.word}: [${fmt(w.x)}, ${fmt(w.y)}]`}
            data-word={w.word}
            data-x={w.x}
            data-y={w.y}
            data-label={w.label ?? 'right'}
          >
            <circle class="wm-hit" cx={px(w.x)} cy={py(w.y)} r={hitRadius(w)} />
            <circle class="wm-dot" cx={px(w.x)} cy={py(w.y)} r="6" />
            <text class="wm-word" x={px(w.x) + l.dx} y={py(w.y) + l.dy} text-anchor={l.anchor}>{w.word}</text>
            <text class="wm-readout wm-value" x={AX + SIZE} y={TOP - 24} text-anchor="end">
              <tspan class="wm-readout-word">{w.word}</tspan>
              <tspan class="wm-nums" dx="8">[{fmt(w.x)}, {fmt(w.y)}]</tspan>
            </text>
          </g>
        );
      })}
    </g>
  </svg>

  {shuffle && (
    <div class="wm-shuffle-row wm-js">
      <button type="button" class="wm-shuffle">Shuffle</button>
    </div>
  )}

  {editable && (
    <form class="wm-form wm-js">
      <label class="wm-field wm-field-word">
        <span>Your word</span>
        <input name="word" type="text" maxlength="14" placeholder={placeholder} autocomplete="off" spellcheck="false" />
      </label>
      <label class="wm-field">
        <span>{xLabel} <output name="xout">0.5</output></span>
        <input name="x" type="range" min="0" max="1" step="0.05" value="0.5" />
      </label>
      <label class="wm-field">
        <span>{yLabel} <output name="yout">0.5</output></span>
        <input name="y" type="range" min="0" max="1" step="0.05" value="0.5" />
      </label>
      <div class="wm-buttons">
        <button type="submit" class="wm-add">Add word</button>
        <button type="button" class="wm-reset">Reset</button>
      </div>
    </form>
  )}

  {caption && <figcaption aria-live="polite">{caption}</figcaption>}
</figure>

<script>
  const NS = 'http://www.w3.org/2000/svg';
  const MAX_EXTRA = 12;
  const fmt = (n: number) => {
    const s = n.toFixed(2);
    return s.endsWith('0') ? n.toFixed(1) : s;
  };
  const clamp = (v: number) => Math.min(1, Math.max(0, v));
  const snap = (v: number) => Math.round(v * 20) / 20; // steps of 0.05

  type Geom = {
    size: number;
    left: number;
    top: number;
    pad: number;
    offsets: Record<string, { dx: number; dy: number; anchor: string }>;
  };

  function setup(fig: HTMLElement) {
    const svg = fig.querySelector('svg') as SVGSVGElement;
    const words = svg.querySelector('.wm-words') as SVGGElement;
    const caption = fig.querySelector('figcaption');
    const form = fig.querySelector('.wm-form') as HTMLFormElement | null;
    if (!form) return;

    const g: Geom = JSON.parse(fig.dataset.geom!);
    const scale = (v: number) => ((v + g.pad) / (1 + 2 * g.pad)) * g.size;
    const px = (v: number) => g.left + scale(v);
    const py = (v: number) => g.top + g.size - scale(v);
    const fromPx = (sx: number) => ((sx - g.left) / g.size) * (1 + 2 * g.pad) - g.pad;
    const fromPy = (sy: number) => ((g.top + g.size - sy) / g.size) * (1 + 2 * g.pad) - g.pad;

    const initialWords = words.innerHTML;
    const initialCaption = caption?.textContent ?? '';
    const wordInput = form.elements.namedItem('word') as HTMLInputElement;
    const xInput = form.elements.namedItem('x') as HTMLInputElement;
    const yInput = form.elements.namedItem('y') as HTMLInputElement;
    const xOut = form.elements.namedItem('xout') as HTMLOutputElement;
    const yOut = form.elements.namedItem('yout') as HTMLOutputElement;

    form.hidden = false;
    fig.classList.add('wm-live');

    const pts = () => Array.from(words.querySelectorAll<SVGGElement>('.wm-pt'));
    const val = (pt: SVGGElement) => ({ x: Number(pt.dataset.x), y: Number(pt.dataset.y) });

    function place(pt: SVGGElement, x: number, y: number) {
      pt.dataset.x = String(x);
      pt.dataset.y = String(y);
      const off = g.offsets[pt.dataset.label ?? 'right'];
      pt.querySelectorAll('circle').forEach((c) => {
        c.setAttribute('cx', String(px(x)));
        c.setAttribute('cy', String(py(y)));
      });
      const label = pt.querySelector('.wm-word')!;
      label.setAttribute('x', String(px(x) + off.dx));
      label.setAttribute('y', String(py(y) + off.dy));
      label.setAttribute('text-anchor', off.anchor);
      const nums = `[${fmt(x)}, ${fmt(y)}]`;
      const numsEl = pt.querySelector('.wm-nums');
      if (numsEl) numsEl.textContent = nums;
      pt.setAttribute('aria-label', `${pt.dataset.word}: ${nums}`);
    }

    function svgEl<K extends keyof SVGElementTagNameMap>(tag: K, attrs: Record<string, string | number> = {}) {
      const el = document.createElementNS(NS, tag);
      for (const [k, v] of Object.entries(attrs)) el.setAttribute(k, String(v));
      return el;
    }

    function makeWord(word: string, x: number, y: number, ghost = false) {
      const pt = svgEl('g', { class: ghost ? 'wm-pt wm-pt-user wm-ghost' : 'wm-pt wm-pt-user' });
      if (!ghost) {
        pt.setAttribute('tabindex', '0');
        pt.setAttribute('role', 'img');
      }
      pt.dataset.word = word;
      pt.dataset.label = x > 0.7 ? 'left' : 'right';
      pt.append(svgEl('circle', { class: 'wm-hit', r: 12 }), svgEl('circle', { class: 'wm-dot', r: 6 }));
      const label = svgEl('text', { class: 'wm-word' });
      label.textContent = word;
      pt.append(label);
      if (!ghost) {
        const readout = svgEl('text', {
          class: 'wm-readout wm-value',
          x: g.left + g.size,
          y: g.top - 24,
          'text-anchor': 'end',
        });
        const rw = svgEl('tspan', { class: 'wm-readout-word' });
        rw.textContent = word;
        const rn = svgEl('tspan', { class: 'wm-nums', dx: 8 });
        readout.append(rw, rn);
        pt.append(readout);
      }
      place(pt, x, y);
      return pt;
    }

    // Live preview of the word you're about to add
    const ghost = makeWord('', 0.5, 0.5, true);
    ghost.style.display = 'none';
    svg.append(ghost);

    function updateGhost() {
      const x = Number(xInput.value);
      const y = Number(yInput.value);
      xOut.value = fmt(x);
      yOut.value = fmt(y);
      const word = wordInput.value.trim().toLowerCase();
      ghost.style.display = word ? '' : 'none';
      ghost.dataset.word = word;
      ghost.dataset.label = x > 0.7 ? 'left' : 'right';
      ghost.querySelector('.wm-word')!.textContent = word;
      place(ghost, x, y);
    }

    // Closest word: say it in the caption
    function activate(pt: SVGGElement | null) {
      if (!pt) {
        if (caption) caption.textContent = initialCaption;
        return;
      }
      const a = val(pt);
      let best: SVGGElement | null = null;
      let bestD = Infinity;
      for (const o of pts()) {
        if (o === pt) continue;
        const b = val(o);
        const d = Math.hypot(a.x - b.x, a.y - b.y);
        if (d < bestD) {
          bestD = d;
          best = o;
        }
      }
      if (!best) return;
      if (caption) caption.textContent = `The closest word to "${pt.dataset.word}" is "${best.dataset.word}".`;
    }

    const ptFrom = (t: EventTarget | null) =>
      t instanceof Element ? (t.closest('.wm-words .wm-pt') as SVGGElement | null) : null;

    let dragging: SVGGElement | null = null;

    svg.addEventListener('focusin', (e) => {
      const pt = ptFrom(e.target);
      if (pt) activate(pt);
    });
    svg.addEventListener('pointerover', (e) => {
      const pt = ptFrom(e.target);
      if (pt && !dragging) activate(pt);
    });
    svg.addEventListener('pointerleave', () => {
      if (!dragging) activate(ptFrom(document.activeElement));
    });
    svg.addEventListener('focusout', (e) => {
      if (!ptFrom(e.relatedTarget)) activate(null);
    });

    // Dragging (mouse, touch and pen)
    svg.addEventListener('pointerdown', (e) => {
      const pt = ptFrom(e.target);
      if (!pt) return;
      e.preventDefault();
      dragging = pt;
      pt.focus({ preventScroll: true });
      svg.setPointerCapture(e.pointerId);
      fig.classList.add('wm-dragging');
    });
    svg.addEventListener('pointermove', (e) => {
      if (!dragging) return;
      const m = svg.getScreenCTM();
      if (!m) return;
      const p = new DOMPoint(e.clientX, e.clientY).matrixTransform(m.inverse());
      place(dragging, snap(clamp(fromPx(p.x))), snap(clamp(fromPy(p.y))));
      activate(dragging);
    });
    const stop = () => {
      dragging = null;
      fig.classList.remove('wm-dragging');
    };
    svg.addEventListener('pointerup', stop);
    svg.addEventListener('pointercancel', stop);

    // Arrow keys move the focused word
    const steps: Record<string, [number, number]> = {
      ArrowLeft: [-0.05, 0],
      ArrowRight: [0.05, 0],
      ArrowUp: [0, 0.05],
      ArrowDown: [0, -0.05],
    };
    svg.addEventListener('keydown', (e) => {
      const pt = ptFrom(e.target);
      const s = steps[e.key];
      if (!pt || !s) return;
      e.preventDefault();
      const v = val(pt);
      place(pt, snap(clamp(v.x + s[0])), snap(clamp(v.y + s[1])));
      activate(pt);
    });

    // Adding words
    form.addEventListener('input', updateGhost);
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const word = wordInput.value.trim().toLowerCase();
      if (!word) {
        wordInput.focus();
        return;
      }
      const x = Number(xInput.value);
      const y = Number(yInput.value);
      let pt = pts().find((p) => p.dataset.word === word) ?? null;
      if (pt) {
        place(pt, x, y);
      } else if (words.querySelectorAll('.wm-pt-user').length >= MAX_EXTRA) {
        if (caption) caption.textContent = 'That\'s plenty of words! Hit "Reset" to start over.';
        return;
      } else {
        pt = makeWord(word, x, y);
        words.append(pt);
      }
      wordInput.value = '';
      updateGhost();
      activate(pt);
    });

    // Reset
    fig.querySelector('.wm-reset')!.addEventListener('click', () => {
      words.innerHTML = initialWords;
      form.reset();
      updateGhost();
      activate(null);
    });

    updateGhost();
  }

  document.querySelectorAll<HTMLElement>('.wordmap[data-editable]').forEach(setup);

  // ---------- shuffle maps ----------
  function setupShuffle(fig: HTMLElement) {
    const g = JSON.parse(fig.dataset.geom!);
    const scale = (v: number) => ((v + g.pad) / (1 + 2 * g.pad)) * g.size;
    const px = (v: number) => g.left + scale(v);
    const py = (v: number) => g.top + g.size - scale(v);
    const pts = Array.from(fig.querySelectorAll<SVGGElement>('.wm-words .wm-pt'));
    const row = fig.querySelector<HTMLElement>('.wm-shuffle-row');
    const btn = fig.querySelector<HTMLButtonElement>('.wm-shuffle');
    if (!row || !btn) return;
    row.hidden = false;

    // Same logic as scatter() in the component's frontmatter
    function scatter(list: string[]) {
      const boxes: number[][] = [];
      const hits = (b: number[]) => boxes.some((o) => b[0] < o[2] && b[2] > o[0] && b[1] < o[3] && b[3] > o[1]);
      return list.map((word) => {
        let best = { x: 0.5, y: 0.5, label: 'right' };
        for (let t = 0; t < 300; t++) {
          const x = Math.round((0.06 + Math.random() * 0.88) * 100) / 100;
          const y = Math.round((0.06 + Math.random() * 0.88) * 100) / 100;
          const label = x > 0.7 ? 'left' : 'right';
          const cx = px(x);
          const cy = py(y);
          const tw = word.length * 0.58 * 17 + 4;
          const dot = [cx - 10, cy - 10, cx + 10, cy + 10];
          const text = label === 'right' ? [cx + 10, cy - 9, cx + 14 + tw, cy + 10] : [cx - 14 - tw, cy - 9, cx - 10, cy + 10];
          best = { x, y, label };
          if (!hits(dot) && !hits(text)) {
            boxes.push(dot, text);
            return best;
          }
        }
        return best;
      });
    }

    btn.addEventListener('click', () => {
      const spots = scatter(pts.map((p) => p.dataset.word ?? ''));
      pts.forEach((pt, i) => {
        const { x, y, label } = spots[i];
        const off = g.offsets[label];
        pt.dataset.x = String(x);
        pt.dataset.y = String(y);
        pt.querySelectorAll('circle').forEach((c) => {
          c.setAttribute('cx', String(px(x)));
          c.setAttribute('cy', String(py(y)));
          if (c.classList.contains('wm-hit')) c.setAttribute('r', '12');
        });
        const text = pt.querySelector('.wm-word')!;
        text.setAttribute('x', String(px(x) + off.dx));
        text.setAttribute('y', String(py(y) + off.dy));
        text.setAttribute('text-anchor', off.anchor);
        const nums = `[${fmt(x)}, ${fmt(y)}]`;
        pt.querySelector('.wm-nums')!.textContent = nums;
        pt.setAttribute('aria-label', `${pt.dataset.word}: ${nums}`);
      });
    });
  }

  document.querySelectorAll<HTMLElement>('.wordmap[data-shuffle]').forEach(setupShuffle);
</script>

<style is:global>
  .wordmap {
    margin: 1.6em 0 1.8em;
    padding: 12px 12px 14px;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--paper-2);
  }
  .wordmap svg {
    display: block;
    width: 100%;
    max-width: 460px;
    height: auto;
    margin: 0 auto;
    font-family: var(--font-ui);
    overflow: visible;
    user-select: none;
    -webkit-user-select: none;
  }
  .wordmap figcaption {
    margin-top: 8px;
    text-align: center;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: var(--ink-soft);
  }

  .wordmap .wm-grid line { stroke: var(--rule); stroke-width: 1; }
  .wordmap .wm-axis { stroke: var(--ink-soft); stroke-width: 1.5; }
  .wordmap .wm-arrow { fill: var(--ink-soft); }
  .wordmap .wm-tick { fill: var(--ink-soft); font-size: 13px; font-family: var(--font-mono); }
  .wordmap .wm-axis-label { fill: var(--ink); font-size: 16px; font-weight: 600; }

  .wordmap .wm-readout { font-family: var(--font-mono); font-size: 17px; }
  .wordmap .wm-hint { fill: var(--ink-soft); font-family: var(--font-ui); font-size: 15px; }
  .wordmap .wm-value { fill: var(--ink); opacity: 0; pointer-events: none; transition: opacity 0.15s ease; }
  .wordmap .wm-readout-word { font-weight: 600; }

  .wordmap .wm-pt { cursor: pointer; outline: none; }
  .wordmap .wm-hit { fill: transparent; }
  .wordmap .wm-dot {
    stroke: var(--paper-2);
    stroke-width: 2;
    transform-box: fill-box;
    transform-origin: center;
    transition: transform 0.15s ease;
  }
  .wordmap .wm-pt-a .wm-dot { fill: var(--accent); }
  .wordmap .wm-pt-b .wm-dot { fill: var(--slate); }
  .wordmap .wm-pt-user .wm-dot { fill: var(--ink); }
